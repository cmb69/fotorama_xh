<?xml version="1.0" encoding="UTF-8"?>

<project name="Fotorama" default="help">

  <target name="help" description="lists available targets">
    <exec executable="phing" outputProperty="help">
      <arg line="-l"/>
    </exec>
    <echo>${help}</echo>
  </target>

  <target name="sniff" description="checks adherence to PSR-2">
    <exec executable="phpcs" passthru="true" checkreturn="true">
      <arg line="--standard=PSR12 --runtime-set ignore_warnings_on_exit true --colors classes admin.php index.php tests"/>
    </exec>
    <exec executable="phpcs" passthru="true" checkreturn="true">
      <arg line="--standard=PSR12 --runtime-set ignore_warnings_on_exit true --exclude=Generic.Files.LineLength languages"/>
    </exec>
  </target>

  <target name="stan" description="run static analysis">
    <if>
      <versioncompare version="${php.version}" desiredVersion="8.0.0" operator="ge"/>
      <then>
        <exec executable="phpstan" passthru="true" checkreturn="true">
          <arg line="--ansi analyze"/>
        </exec>
      </then>
      <else>
        <exec executable="phpstan" passthru="true" checkreturn="true">
          <arg line="--ansi -cphpstan7.neon analyze"/>
        </exec>
      </else>
    </if>
  </target>

  <target name="test" description="runs all developer tests">
    <exec executable="phpunit" passthru="true" checkreturn="true">
      <arg line="--colors=always"/>
    </exec>
  </target>

  <target name="js" description="formats and checks JavaScript">
    <exec executable="prettier" passthru="true" checkreturn="true">
      <arg line="--write --print-width 100 --tab-width 4 --trailing-comma es5 js/*.js"/>
    </exec>
    <exec executable="jshint" passthru="true" checkreturn="true">
      <arg line="js"/>
    </exec>
    <exec executable="tsc" passthru="true" checkreturn="true"/>
  </target>

  <target name="check" description="runs all checks" depends="sniff,stan,test,js"/>

  <target name="coverage" description="generates coverage report">
    <exec executable="phpunit" passthru="true" checkreturn="true">
      <arg line="--colors=always --coverage-html coverage"/>
    </exec>
  </target>

  <target name="gen-help" description="builds help.htm from README.md">
    <exec executable="pandoc" passthru="true" checkreturn="true">
      <arg value="-s"/>
      <arg value="--eol=lf"/>
      <arg value="--template=help/template.htm"/>
      <arg value="-Vlang=en"/>
      <arg line="-Vpagetitle=&quot;User Manual&quot;"/>
      <arg value="-o"/>
      <arg file="help/help.htm"/>
      <arg file="README.md"/>
      <arg line="-t html"/>
    </exec>
    <exec executable="pandoc" passthru="true" checkreturn="true">
      <arg value="-s"/>
      <arg value="--eol=lf"/>
      <arg value="--template=help/template.htm"/>
      <arg value="-Vlang=de"/>
      <arg line="-Vpagetitle=&quot;Benutzerhandbuch&quot;"/>
      <arg value="-o"/>
      <arg file="help/help_de.htm"/>
      <arg file="README_DE.md"/>
      <arg line="-t html"/>
    </exec>
  </target>

  <target name="build" description="builds a distributable ZIP archive">
    <exec executable="git" checkreturn="true">
      <arg line="archive -o export.zip HEAD"/>
    </exec>
    <unzip file="export.zip" todir="export"/>
    <delete file="export.zip"/>
    <jsMin targetDir="dist/js" suffix=".min" failonerror="true">
      <fileset dir="export/js">
        <include name="admin.js"/>
        <include name="fotorama.js"/>
      </fileset>
    </jsMin>
    <move todir="dist">
      <fileset dir="export">
        <include name="views/*.php"/>
      </fileset>
      <filterchain>
        <replaceregexp>
          <regexp pattern="&lt;\?(?!=|php)" replace="&lt;?php "/>
        </replaceregexp>
      </filterchain>
    </move>
    <move todir="dist">
      <fileset dir="export">
        <exclude name=".github/**"/>
        <exclude name=".phive/**"/>
        <exclude name="tests/**"/>
        <exclude name="help/template.htm"/>
        <exclude name="js/types.d.ts"/>
        <exclude name="README*.md"/>
        <exclude name="build.xml"/>
        <exclude name="composer.json"/>
        <exclude name="composer.lock"/>
        <exclude name="phpstan*.*"/>
        <exclude name="phpunit.xml"/>
        <exclude name="teplad.xml"/>
      </fileset>
    </move>
    <delete dir="export"/>
    <copy file="dist/config/config.php" tofile="dist/config/defaultconfig.php"/>
    <copy file="dist/languages/en.php" tofile="dist/languages/default.php"/>
    <zip destfile="Fotorama_XH-1.1-dev.zip" basedir="dist" prefix="fotorama/"/>
    <delete dir="dist"/>
  </target>

</project>
